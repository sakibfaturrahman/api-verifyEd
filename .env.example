# ===========================
# Server
# ===========================
NODE_ENV=development
PORT=5000

# ===========================
# Supabase
# ===========================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===========================
# Supabase Storage Buckets
# ===========================
SUPABASE_STORAGE_BUCKET_ORIGINAL=certificates-original
SUPABASE_STORAGE_BUCKET_GENERATED=certificates-generated

# ===========================
# CORS
# ===========================
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ===========================
# File Upload Limits
# ===========================
# Max single file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760
# Max files per bulk upload (default: 50)
MAX_BULK_FILES=50

# ===========================
# Rate Limiting
# ===========================
# Verification endpoint: requests per window
RATE_LIMIT_VERIFY_MAX=30
RATE_LIMIT_VERIFY_WINDOW_MS=60000

# General API: requests per window
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MS=60000

# Auth endpoints: requests per window
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000

# ===========================
# Signed URL Expiry
# ===========================
# Download URL expiry in seconds (default: 3600 = 1 hour)
SIGNED_URL_EXPIRY=3600

# ===========================
# Logging
# ===========================
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
